<Window x:Class="DanBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DanBackup.App.Views"
        Title="{Binding Title}"
        Icon="Assets/icon.ico"
        Width="1150" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Atualização disponível -->
        <Border DockPanel.Dock="Top" Background="#302B7CD3" Padding="16,8"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Depois" Margin="8,0,0,0" Command="{Binding DismissUpdateCommand}"
                        IsEnabled="{Binding CanInstallUpdate}" />
                <Button DockPanel.Dock="Right" Content="Atualizar agora" Command="{Binding InstallUpdateCommand}"
                        IsEnabled="{Binding CanInstallUpdate}" />
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="8" Margin="0,0,12,0" Maximum="100"
                             Value="{Binding UpdateProgress}"
                             Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Text="{Binding UpdateText}" />
            </DockPanel>
        </Border>

        <!-- Aviso de administrador -->
        <Border DockPanel.Dock="Top" Background="#30E08A00" Padding="16,8"
                Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reiniciar como administrador" Command="{Binding RestartAsAdminCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Rodando sem privilégios de administrador: o backup de Wi-Fi (com senhas) e de drivers e a restauração de impressoras ficam desabilitados." />
            </DockPanel>
        </Border>

        <TabControl Margin="8,4,8,8" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Backup">
                <views:BackupView DataContext="{Binding Backup}" />
            </TabItem>
            <TabItem Header="Verificar">
                <views:VerifyView DataContext="{Binding Verify}" />
            </TabItem>
            <TabItem Header="Restaurar">
                <views:RestoreView DataContext="{Binding Restore}" />
            </TabItem>
            <TabItem Header="Configurações">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
