<UserControl x:Class="DanBackup.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DanBackup.App.Views">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Backup:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Grid.Column="1" Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Escolher backup..." Margin="8,0,0,0" Command="{Binding BrowseBackupCommand}" Style="{DynamicResource AccentButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                    Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Senha do backup:" VerticalAlignment="Center" Margin="0,0,10,0" />
            <views:PasswordField />
        </StackPanel>
        <DockPanel Margin="0,0,0,8">
            <Button Content="Marcar tudo" Command="{Binding SelectAllCommand}" />
            <Button Content="Desmarcar tudo" Margin="8,0,0,0" Command="{Binding SelectNoneCommand}" />
            <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource SecondaryText}" />
            <TextBlock Text="{Binding ManifestSummary}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        </StackPanel>

        <TreeView Grid.Row="2" ItemsSource="{Binding Modules}" ItemContainerStyle="{StaticResource ModuleTreeItem}" />

        <StackPanel Grid.Row="3" Margin="0,10,0,6">
            <ProgressBar Height="6" Value="{Binding Progress}" Maximum="100" />
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <views:LogView Grid.Row="4" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Abrir pasta do backup" Command="{Binding OpenBackupFolderCommand}" />
            <Button Content="Cancelar" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
            <Button Content="Restaurar selecionados..." Margin="8,0,0,0" MinWidth="160" Command="{Binding RestoreCommand}" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
