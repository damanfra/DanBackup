<UserControl x:Class="DanBackup.App.Views.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: OperationViewModelBase (Password, RememberPassword). PasswordBox não aceita binding; ver code-behind. -->
    <StackPanel Orientation="Horizontal">
        <PasswordBox x:Name="Box" Width="220" PasswordChanged="OnPasswordChanged" VerticalAlignment="Center" />
        <CheckBox Content="Lembrar neste computador" IsChecked="{Binding RememberPassword}" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip="Guarda a senha protegida pelo Windows (só este usuário neste computador consegue lê-la)." />
    </StackPanel>
</UserControl>
